# Copy to `.env` and fill in. `.env` is git-ignored — NEVER commit real secrets.
# Tier-1 (the research loop) needs NONE of these — it runs on the standard library.

# --- LLM provider (chatbot + `--use-llm` research runs), via llm_gateway ---
LLM_PROVIDER=anthropic                       # anthropic | bedrock | ollama
LLM_MODEL=                                   # blank = the provider's default model

# anthropic: Claude Haiku direct. Set a monthly spend cap in the console.
ANTHROPIC_API_KEY=

# bedrock: Claude on AWS Bedrock (standard AWS credential chain; enable model access first)
AWS_REGION=us-east-1
AWS_PROFILE=
LLM_BEDROCK_CLIENT=legacy                    # legacy (AnthropicBedrock) | mantle (AnthropicBedrockMantle)

# ollama: a local model, no key, no cost
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- v1 web app: backend (safe defaults; override as needed) ---
# QDRANT_URL=                               # unset = Qdrant local on-disk; set (+ QDRANT_API_KEY) = Qdrant Cloud
FRONTEND_ORIGIN=http://localhost:3000       # CORS: your frontend origin
RATE_LIMIT_PER_MIN=20                        # per-IP chat rate limit
DAILY_REQUEST_CAP=500                        # global daily chat request cap

# --- v1 web app: frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Tier-2 / Tier-3 (as services come online) ---
# LITELLM_MODEL=claude-sonnet-5
# LANGSMITH_API_KEY=
# LOGFIRE_TOKEN=
# CLERK_SECRET_KEY=                          # v2 auth only — not needed in v1
