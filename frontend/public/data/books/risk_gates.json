  "will_not_save_you_from": [
    {
      "title": "A slow bleed",
      "body": "The daily cap bounds one session and the weekly one bounds a week that starts badly. A run of days each landing just inside the daily cap passes through the whole stack untouched."
    },
    {
      "title": "A wrong-way book",
      "body": "If every leg is on the wrong side of a trending market, no stop-loss layer fixes that. It only decides how fast you pay for it."
    },
    {
      "title": "A gate that cannot read its ledger",
      "body": "The weekly floor reads week-to-date once, at startup, from the persistent ledger. If that read fails the floor falls back to the day's own cap — it fails OPEN, not shut."
    },
    {
      "title": "A week that crosses the line today",
      "body": "Week-to-date is fixed at startup and does not update as today's trades close, so a week that breaches mid-session is still bounded only by the daily cap."
    }
  ]
