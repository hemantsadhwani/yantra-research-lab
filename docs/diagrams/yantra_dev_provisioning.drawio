        <mxCell id="p1-43" value="attached" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.4;entryX=0;entryY=0.18;" edge="1" parent="1" source="p1-23" target="p1-33">
