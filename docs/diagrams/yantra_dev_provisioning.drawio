        </mxCell>
        <mxCell id="p1-21" value="&lt;b&gt;yantra-admin-temp&lt;/b&gt; · AdministratorAccess&lt;br&gt;used 30 Sep (setup) + 1 Oct (S3 access);&lt;br&gt;a fresh key each time, deleted right after" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="480" width="380" height="80" />
