  <diagram name="2 What we did - steps" id="2_What_we_did_-_steps">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-1" value="What we did, step by step — and what comes next" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="10" width="800" height="40" />
        </mxCell>
        <mxCell id="p2-2" value="Read left → right on the top row, then right → left on the bottom row. Steps 1–10 done on 30 Sep. On 1 Oct: S3 access for the box, two QLoRA sessions, and terminate-after-session." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="48" width="1100" height="40" />
        </mxCell>
        <mxCell id="p2-3" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="15" width="90" height="26" />
        </mxCell>
        <mxCell id="p2-4" value="Done ✓" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="15" width="165" height="26" />
        </mxCell>
        <mxCell id="p2-5" value="Waiting on AWS ⏳" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1115" y="15" width="165" height="26" />
        </mxCell>
        <mxCell id="p2-6" value="Next — not created yet" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1290" y="15" width="165" height="26" />
        </mxCell>
        <mxCell id="p2-7" value="Removed / to delete" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1465" y="15" width="165" height="26" />
        </mxCell>
        <mxCell id="p2-8" value="Existing, untouched" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="15" width="165" height="26" />
        </mxCell>
        <mxCell id="p2-9" value="&lt;b&gt;1 · Tidy nifty_dev&lt;/b&gt;&lt;hr&gt;Home folder 30 → 15 GB (Cursor, stale data copy, old VS Code servers, caches).&lt;br&gt;Repos cloned into &lt;b&gt;~/work&lt;/b&gt;. Dotfiles hidden in VS Code." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="130" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-10" value="&lt;b&gt;2 · Temp admin (you)&lt;/b&gt;&lt;hr&gt;Console: user &lt;b&gt;yantra-admin-temp&lt;/b&gt; + AdministratorAccess → access key.&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;aws configure --profile yantra-admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="130" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-11" value="&lt;b&gt;3 · setup_account.sh (me)&lt;/b&gt;&lt;hr&gt;Role + instance profile &lt;b&gt;yantra-dev-bedrock&lt;/b&gt;, alarm service-linked role, user &lt;b&gt;claude-dev-launcher&lt;/b&gt; + managed policy, key → profile &lt;b&gt;yantra-launcher&lt;/b&gt;, GPU quota requests." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="660" y="130" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-12" value="&lt;b&gt;4 · Verify&lt;/b&gt;&lt;hr&gt;preflight as launcher ✓&lt;br&gt;dry-run RunInstances / CreateKeyPair / CreateSecurityGroup → “would have succeeded” ✓&lt;br&gt;Bedrock Haiku call → “ok” ✓" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="130" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-13" value="&lt;b&gt;5 · Remove admin&lt;/b&gt;&lt;hr&gt;Admin access key deleted in AWS, profile removed from nifty_dev.&lt;br&gt;&lt;b&gt;You: delete user yantra-admin-temp in the console.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="130" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-14" value="&lt;b&gt;6 · GPU quota ✓&lt;/b&gt;&lt;hr&gt;On-demand G/VT 0 → 8 approved after ~1.5 h (spot stayed 0).&lt;br&gt;Then the EC2 limit took ~20 min more to apply, and Mumbai had no g5 capacity for ~20 min." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1590" y="130" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-15" value="&lt;b&gt;7 · Plan (free)&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;launch.sh plan&lt;/font&gt; prints type, AMI, subnet, disk, role, key pair, SSH IP, idle alarm. Nothing is created." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1590" y="420" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-16" value="&lt;b&gt;8 · You said&lt;br&gt;“yes launch” ✓&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;(+ approval rule: anything &amp;gt; $1)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="420" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-17" value="&lt;b&gt;9 · Launch (bills)&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;launch.sh launch --yes&lt;/font&gt;&lt;br&gt;key pair + SG (SSH from this IP) + g5.xlarge + idle-stop alarm. Launched with DISK_GB=100 (not 200) to halve disk cost." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="420" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-18" value="&lt;b&gt;10 · Bootstrap&lt;/b&gt;&lt;hr&gt;SSH once: git clone yantra → tmux runs &lt;b&gt;bootstrap.sh&lt;/b&gt; → poll ~/bootstrap.log.&lt;br&gt;All PASS. First try died on the first-boot apt lock → bootstrap.sh now waits for it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="660" y="420" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-19" value="&lt;b&gt;11 · Hand-off&lt;/b&gt;&lt;hr&gt;On the box: install Claude Code, &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;gh auth login&lt;/font&gt; (fine-grained token, 2 repos). Set LLM_MODEL=in.anthropic… &lt;b&gt;(you, now)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="420" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-20" value="&lt;b&gt;12 · Day to day&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;launch.sh stop&lt;/font&gt; when idle · &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;start&lt;/font&gt; (new IP) · &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;resize t4g.large --yes&lt;/font&gt; after training · never terminate unless you say so." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="420" width="260" height="190" />
        </mxCell>
        <mxCell id="p2-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2-9" target="p2-10">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2-10" target="p2-11">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2-11" target="p2-12">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2-12" target="p2-13">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2-13" target="p2-14">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-26" value="quota approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2-14" target="p2-15">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2-15" target="p2-16">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2-16" target="p2-17">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2-17" target="p2-18">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2-18" target="p2-19">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2-19" target="p2-20">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p2-32" value="📍 you are here" style="rounded=1;html=1;fontSize=12;fontStyle=1;fillColor=#d6b656;fontColor=#ffffff;strokeColor=none;align=center;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="405" y="620" width="150" height="30" />
        </mxCell>
        <mxCell id="p2-33" value="Five ideas worth remembering" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="660" width="1760" height="30" />
        </mxCell>
        <mxCell id="p2-34" value="&lt;b&gt;Least privilege&lt;/b&gt;&lt;br&gt;Admin power was used &lt;b&gt;once&lt;/b&gt; and its key deleted. The daily login can only act on resources tagged purpose=dev-public-repos — it cannot touch the trading bot." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="700" width="335" height="150" />
        </mxCell>
        <mxCell id="p2-35" value="&lt;b&gt;No keys on servers&lt;/b&gt;&lt;br&gt;The dev box gets Bedrock through an &lt;b&gt;instance role&lt;/b&gt;. Credentials are short-lived and rotate automatically — nothing to leak from ~/.aws on the box." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="395" y="700" width="335" height="150" />
        </mxCell>
        <mxCell id="p2-36" value="&lt;b&gt;Money gates&lt;/b&gt;&lt;br&gt;Quota, plan and dry-runs are free. Only &lt;b&gt;launch&lt;/b&gt;, &lt;b&gt;start&lt;/b&gt; and &lt;b&gt;resize&lt;/b&gt; bill. The idle alarm stops the box after 60 quiet minutes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="750" y="700" width="335" height="150" />
        </mxCell>
        <mxCell id="p2-37" value="&lt;b&gt;Keep the live host clean&lt;/b&gt;&lt;br&gt;nifty_dev runs the market-hours monitor. It only launches the box — no Docker, GPU jobs or model downloads there." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1105" y="700" width="335" height="150" />
        </mxCell>
        <mxCell id="p2-38" value="&lt;b&gt;Mumbai model IDs&lt;/b&gt;&lt;br&gt;Use &lt;b&gt;in.&lt;/b&gt; (India) or &lt;b&gt;global.&lt;/b&gt; inference profiles. &lt;b&gt;us.&lt;/b&gt; and &lt;b&gt;apac.&lt;/b&gt; do not route from ap-south-1 here." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1460" y="700" width="335" height="150" />
        </mxCell>
        <mxCell id="p2-39" value="&lt;b&gt;Files involved&lt;/b&gt;&lt;br&gt;~/work/yantra-research-lab/deploy/ec2/&lt;b&gt;setup_account.sh&lt;/b&gt; — one-time account setup (new, not committed yet)&lt;br&gt;~/work/yantra-research-lab/deploy/ec2/&lt;b&gt;launch.sh&lt;/b&gt; — preflight · quota · plan · launch · status · ssh · stop · start · resize · terminate&lt;br&gt;~/work/yantra-research-lab/deploy/ec2/&lt;b&gt;bootstrap.sh&lt;/b&gt; — runs on the dev box&lt;br&gt;~/work/yantra-research-lab/deploy/ec2/iam/&lt;b&gt;launcher-policy.json&lt;/b&gt;, &lt;b&gt;bedrock-dev-role-policy.json&lt;/b&gt;, &lt;b&gt;dev-box-s3-policy.json&lt;/b&gt;&lt;br&gt;~/.aws/credentials — profile &lt;b&gt;yantra-launcher&lt;/b&gt; (only profile on nifty_dev) · ~/.ssh/yantra-dev.pem — created at launch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="880" width="1760" height="180" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 Who can do what" id="3_Who_can_do_what">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-1" value="Who can do what — and the commands you will use" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="10" width="1200" height="40" />
        </mxCell>
        <mxCell id="p3-2" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #bbb;padding:6px;background:#eeeeee;text-align:left'&gt;Identity&lt;/th&gt;&lt;th style='border:1px solid #bbb;padding:6px;background:#eeeeee;text-align:left'&gt;Where its credentials live&lt;/th&gt;&lt;th style='border:1px solid #bbb;padding:6px;background:#eeeeee;text-align:left'&gt;Can do&lt;/th&gt;&lt;th style='border:1px solid #bbb;padding:6px;background:#eeeeee;text-align:left'&gt;Cannot / notes&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f8cecc'&gt;&lt;b&gt;yantra-admin-temp&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;none — key deleted&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;everything (AdministratorAccess)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;Used once for setup_account.sh. Delete the user in the console.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#d5e8d4'&gt;&lt;b&gt;claude-dev-launcher&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;nifty_dev ~/.aws profile yantra-launcher&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;describe EC2 · launch g5/g6/g4dn/t4g/c7g/m7i with tag purpose=dev-public-repos · start/stop/resize/terminate tagged boxes · create key pair + SG · pass role yantra-dev-bedrock · request GPU quota · idle alarm yantra-dev-*&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;IAM changes · untagged resources (the trading bot) · other regions · Bedrock · S3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#d5e8d4'&gt;&lt;b&gt;yantra-dev-bedrock (role)&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;none stored — instance metadata, auto-rotating&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;bedrock:InvokeModel(+stream) on anthropic.* models and *.anthropic.* profiles · list models/profiles · S3 read yantra-corpus/* · S3 read+write ml/* (policy dev-box-s3-policy.json)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;EC2 · IAM · writing yantra-corpus/ · deleting anything in S3 · other buckets · non-Anthropic models&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#dae8fc'&gt;&lt;b&gt;yantra-ingest&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;GitHub Actions secret&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;S3 corpus bucket (unchanged)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;everything else&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#dae8fc'&gt;&lt;b&gt;hemant-window&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;your Windows machine&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;unchanged&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
