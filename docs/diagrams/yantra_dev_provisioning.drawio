        <mxCell id="p1-22" value="Roles (no keys — temporary creds)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#B0084D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="575" width="200" height="22" />
        </mxCell>
        <mxCell id="p1-23" value="&lt;b&gt;yantra-dev-bedrock&lt;/b&gt; ✓ role + instance profile&lt;br&gt;trusted by: EC2&lt;br&gt;Bedrock: InvokeModel on anthropic.*&lt;br&gt;S3: read &lt;b&gt;yantra-corpus/*&lt;/b&gt; · read+write &lt;b&gt;ml/*&lt;/b&gt; · no delete&lt;br&gt;attached to the dev box" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="602" width="380" height="115" />
        </mxCell>
        <mxCell id="p1-24" value="&lt;b&gt;AWSServiceRoleForCloudWatchEvents&lt;/b&gt; ✓&lt;br&gt;lets the idle alarm stop the box" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="727" width="380" height="60" />
        </mxCell>
        <mxCell id="p1-25" value="&lt;b&gt;Source of truth (in the repo)&lt;/b&gt;&lt;br&gt;deploy/ec2/iam/launcher-policy.json&lt;br&gt;deploy/ec2/iam/bedrock-dev-role-policy.json&lt;br&gt;deploy/ec2/setup_account.sh re-applies them" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="805" width="380" height="110" />
        </mxCell>
        <mxCell id="p1-26" value="&lt;b&gt;Why two identities?&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Admin&lt;/b&gt; used once, then its key deleted.&lt;br&gt;• &lt;b&gt;Launcher&lt;/b&gt; (daily) can only touch tagged dev resources — it cannot see or stop the trading bot.&lt;br&gt;• &lt;b&gt;Role&lt;/b&gt; gives the dev box Bedrock with no keys stored on it (auto-rotating creds from instance metadata)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="930" width="380" height="190" />
        </mxCell>
        <mxCell id="p1-27" value="Region ap-south-1 (Mumbai)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="150" width="920" height="990" />
        </mxCell>
        <mxCell id="p1-28" value="&lt;b&gt;🖥 nifty_dev&lt;/b&gt; — EC2 c7g.2xlarge (Graviton, 8 vCPU, 16 GB)&lt;br&gt;AZ 1c · Amazon Linux 2023&lt;br&gt;&lt;i&gt;Live trading monitor host · cron 08:15–15:15 IST&lt;/i&gt;&lt;hr&gt;~/index-options-trading-bot · data_pull · shadow_bt* — &lt;b&gt;never touched&lt;/b&gt;&lt;br&gt;~/work/ yantra-research-lab · agentic-reporting · founder-profile&lt;br&gt;~/.aws → profile &lt;b&gt;yantra-launcher&lt;/b&gt; only&lt;br&gt;Job here: run setup_account.sh (once) and launch.sh.&lt;br&gt;No Docker · no GPU · no model downloads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="195" width="420" height="265" />
        </mxCell>
        <mxCell id="p1-29" value="&lt;b&gt;Service Quotas&lt;/b&gt; ✓&lt;br&gt;Running On-Demand G and VT: 0 → &lt;b&gt;8 vCPU approved&lt;/b&gt; (20:34)&lt;br&gt;All G and VT Spot: 0 → &lt;b&gt;8&lt;/b&gt; (applied by 1 Oct)&lt;br&gt;g5.xlarge needs 4 · first launch hit a short capacity gap in Mumbai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1320" y="195" width="440" height="125" />
        </mxCell>
        <mxCell id="p1-30" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt; ✓ — Claude Haiku 4.5&lt;br&gt;in.anthropic.claude-haiku-4-5-20251001-v1:0&lt;br&gt;global.anthropic.claude-haiku-4-5-20251001-v1:0&lt;br&gt;test call answered “ok” (18 tokens)&lt;br&gt;role check from the box ✓ · ⚠ &lt;b&gt;not&lt;/b&gt; apac." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1320" y="335" width="440" height="125" />
        </mxCell>
        <mxCell id="p1-31" value="Default VPC" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#AAB7B8;dashed=0;html=1;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="500" width="880" height="460" />
        </mxCell>
        <mxCell id="p1-32" value="Security group yantra-dev-ssh — inbound: port 22 from nifty_dev IP (+ home IP) only" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#DD3522;dashed=1;verticalAlign=bottom;align=left;spacingLeft=10;fontColor=#DD3522;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="900" y="545" width="520" height="400" />
        </mxCell>
        <mxCell id="p1-33" value="&lt;b&gt;🧠 yantra_dev&lt;/b&gt; ✓ disposable — none running between sessions&lt;br&gt;g6.xlarge (L4) → g5.xlarge (A10G) → &lt;b&gt;g4dn.xlarge (T4)&lt;/b&gt;, whichever Mumbai has; 1 Oct used g4dn · new IP each launch&lt;br&gt;AMI: Deep Learning Base OSS NVIDIA, Ubuntu 24.04&lt;br&gt;disk &lt;b&gt;100 GB&lt;/b&gt; gp3 (AMI uses ~54) · tag purpose=dev-public-repos&lt;br&gt;instance profile &lt;b&gt;yantra-dev-bedrock&lt;/b&gt; (no keys on box)&lt;hr&gt;bootstrap ✓ yantra 164 passed · agentic-reporting 70 passed&lt;br&gt;EVAL-GATE PASS (both arms) · REPORT-EVAL PASS · SCHEMA-EVAL PASS&lt;br&gt;then: Claude Code + gh auth login&lt;br&gt;AWS_REGION=ap-south-1&lt;br&gt;LLM_MODEL=in.anthropic.claude-haiku-4-5-…&lt;br&gt;≈ $1–1.4/h while running — &lt;b&gt;stop when idle&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="590" width="480" height="315" />
        </mxCell>
        <mxCell id="p1-34" value="&lt;b&gt;Key pair yantra-dev&lt;/b&gt; ✓&lt;br&gt;private key → nifty_dev ~/.ssh/yantra-dev.pem" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1440" y="590" width="300" height="70" />
        </mxCell>
        <mxCell id="p1-35" value="&lt;b&gt;CloudWatch alarm yantra-dev-idle-stop&lt;/b&gt; ✓&lt;br&gt;CPU &amp;lt; 2% for 60 min → stop the box" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1440" y="680" width="300" height="80" />
        </mxCell>
        <mxCell id="p1-36" value="&lt;b&gt;Session policy (1 Oct)&lt;/b&gt;&lt;br&gt;MLflow store + adapters live in S3, so each session ends with &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;launch.sh terminate --yes&lt;/font&gt;.&lt;br&gt;Runbook: deploy/ec2/SESSION_LIFECYCLE.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1440" y="780" width="300" height="145" />
        </mxCell>
        <mxCell id="p1-37" value="&lt;b&gt;How the box gets AWS access (no keys)&lt;/b&gt;&lt;br&gt;1. Code calls Bedrock or S3 (boto3).&lt;br&gt;2. The SDK gets short-lived creds for role &lt;b&gt;yantra-dev-bedrock&lt;/b&gt; from instance metadata.&lt;br&gt;3. IAM checks the role policy → allowed / denied.&lt;br&gt;4. Bedrock bills per token; S3 per GB." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="900" y="975" width="400" height="150" />
        </mxCell>
        <mxCell id="p1-38" value="&lt;b&gt;🪣 S3 yantra-research-lab-data&lt;/b&gt; ✓ (AES256)&lt;br&gt;&lt;b&gt;yantra-corpus/&lt;/b&gt; — owned by the nightly ingest job&lt;br&gt;&amp;nbsp;&amp;nbsp;raw/ &lt;b&gt;426 arXiv PDFs&lt;/b&gt; (807 MB, since 5 Jul) · images/ · figures/&lt;br&gt;&lt;b&gt;ml/&lt;/b&gt; — dev box writes here (empty yet)&lt;br&gt;&amp;nbsp;&amp;nbsp;datasets/ · mlflow/ · models/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1320" y="975" width="440" height="150" />
        </mxCell>
        <mxCell id="p1-39" value="VS Code Remote-SSH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.18;entryX=0.2857;entryY=0;" edge="1" parent="1" source="p1-9" target="p1-28">
