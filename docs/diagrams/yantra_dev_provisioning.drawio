        <mxCell id="p1-19" value="&lt;b&gt;yantra-ingest&lt;/b&gt; · S3-only · used by GitHub Actions&lt;br&gt;untouched — never reuse it for admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
