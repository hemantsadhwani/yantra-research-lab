        </mxCell>
        <mxCell id="p1-20" value="&lt;b&gt;claude-dev-launcher&lt;/b&gt; ✓ created&lt;br&gt;policy &lt;b&gt;yantra-dev-launcher&lt;/b&gt; (managed)&lt;br&gt;can launch / stop / resize &lt;u&gt;only&lt;/u&gt; boxes tagged&lt;br&gt;purpose=dev-public-repos, allowed types, Mumbai&lt;br&gt;key → nifty_dev ~/.aws profile &lt;b&gt;yantra-launcher&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
