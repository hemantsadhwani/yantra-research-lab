        <mxCell id="p1-18" value="&lt;b&gt;hemant-window&lt;/b&gt; · your Windows CLI user · untouched" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
