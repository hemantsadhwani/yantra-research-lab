  <diagram name="1 Architecture" id="1_Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-1" value="Layout SLM — fine-tuning → infra → S3 → MLflow → serving" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="14" width="1100" height="40" />
        </mxCell>
        <mxCell id="p1-2" value="A 1.5B model learns to label a PDF page (text · table-heavy · figure-heavy · scanned · mixed) from the parser's one-line page summary. Teacher = the parser's own rule. Everything that must survive lives in S3 or GitHub; the GPU box is disposable." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="54" width="1100" height="44" />
        </mxCell>
        <mxCell id="p1-3" value="Built and measured ✓" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p1-4" value="Data in S3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p1-5" value="Champion / human gate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p1-6" value="Rejected" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1550" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p1-7" value="Designed, not built" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p1-8" value="① Control plane" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=15;fontStyle=1;spacingTop=8;fontFamily=Helvetica;fillColor=#f0f0f0;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="110" width="340" height="1000" />
        </mxCell>
        <mxCell id="p1-9" value="② Data — S3" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=15;fontStyle=1;spacingTop=8;fontFamily=Helvetica;fillColor=#eef4fb;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="410" y="110" width="340" height="1000" />
        </mxCell>
        <mxCell id="p1-10" value="③ Fine-tuning — GPU box" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=15;fontStyle=1;spacingTop=8;fontFamily=Helvetica;fillColor=#eef7ec;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="110" width="340" height="1000" />
        </mxCell>
        <mxCell id="p1-11" value="④ Registry — MLflow" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=15;fontStyle=1;spacingTop=8;fontFamily=Helvetica;fillColor=#fdf8e6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="110" width="340" height="1000" />
        </mxCell>
        <mxCell id="p1-12" value="⑤ Serving — next" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=15;fontStyle=1;spacingTop=8;fontFamily=Helvetica;fillColor=#f7f7f7;strokeColor=#aaaaaa;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1520" y="110" width="340" height="1000" />
        </mxCell>
        <mxCell id="p1-13" value="&lt;b&gt;🖥 nifty_dev&lt;/b&gt; (trading monitor host)&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;launch.sh&lt;/font&gt; · profile &lt;b&gt;yantra-launcher&lt;/b&gt;&lt;br&gt;can only launch/stop/terminate boxes tagged &lt;i&gt;purpose=dev-public-repos&lt;/i&gt;, in Mumbai or Virginia&lt;br&gt;never runs training itself" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="160" width="310" height="175" />
        </mxCell>
        <mxCell id="p1-14" value="&lt;b&gt;🔑 Box identity&lt;/b&gt; — role &lt;b&gt;yantra-dev-bedrock&lt;/b&gt;&lt;br&gt;no keys on the box (instance metadata)&lt;br&gt;S3: read &lt;b&gt;yantra-corpus/*&lt;/b&gt; · read+write &lt;b&gt;ml/*&lt;/b&gt; · no delete" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="350" width="310" height="120" />
        </mxCell>
        <mxCell id="p1-15" value="&lt;b&gt;One command per session&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;layout_session.sh&lt;/font&gt;&lt;br&gt;install → pull mlflow.db → dataset → QLoRA → eval → register → push mlflow.db (pushed even if a step fails)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="485" width="310" height="135" />
        </mxCell>
        <mxCell id="p1-16" value="&lt;b&gt;Capacity fallbacks&lt;/b&gt; (Mumbai ran out, 1 Oct)&lt;br&gt;g6.xlarge (L4) → g5.xlarge (A10G) → &lt;b&gt;g4dn.xlarge (T4)&lt;/b&gt;, zones 1a/1b&lt;br&gt;us-east-1: launcher allowed, GPU quota 8 vCPU (approved)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="635" width="310" height="150" />
        </mxCell>
        <mxCell id="p1-17" value="&lt;b&gt;Session end&lt;/b&gt;&lt;br&gt;copy the card → &lt;b&gt;terminate&lt;/b&gt;&lt;br&gt;nothing on the box is needed again (see page 4)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="800" width="310" height="120" />
        </mxCell>
        <mxCell id="p1-18" value="&lt;b&gt;Cost, 1 Oct&lt;/b&gt;&lt;br&gt;2 training sessions on a T4 ≈ $1.1 total&lt;br&gt;S3 ≈ 1.2 GB ≈ $0.03/month&lt;br&gt;LLM API calls: none" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="935" width="310" height="155" />
        </mxCell>
        <mxCell id="p1-19" value="&lt;b&gt;🥉 Bronze — raw PDFs&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;yantra-corpus/raw/&lt;/font&gt;&lt;br&gt;&lt;b&gt;426&lt;/b&gt; arXiv q-fin papers · 807 MB&lt;br&gt;written daily by the ingest job (GitHub Actions)&lt;br&gt;box: &lt;b&gt;read only&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="160" width="310" height="150" />
        </mxCell>
        <mxCell id="p1-20" value="&lt;b&gt;🥈 Silver — page features&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;ml/silver/layout_features/&lt;/font&gt;&lt;br&gt;426 files · &lt;b&gt;7,506 pages&lt;/b&gt;&lt;br&gt;first parse 8 min · later rebuilds 10 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="380" width="310" height="150" />
        </mxCell>
        <mxCell id="p1-21" value="&lt;b&gt;🥇 Dataset 87060948b499&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;ml/datasets/layout/87060948b499/&lt;/font&gt;&lt;hr&gt;split &lt;b&gt;by paper&lt;/b&gt; (hash, 80/10/10)&lt;br&gt;&lt;b&gt;train&lt;/b&gt; 344 papers · 6,022 pages&lt;br&gt;&lt;b&gt;val&lt;/b&gt; 41 papers · 741 pages&lt;br&gt;&lt;b&gt;test&lt;/b&gt; 41 papers · 743 pages — &lt;b&gt;locked&lt;/b&gt;&lt;br&gt;+ manifest.json (sha256 of every file)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="600" width="310" height="230" />
        </mxCell>
        <mxCell id="p1-22" value="&lt;b&gt;Labels&lt;/b&gt; = &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;layout_labels.derive_label&lt;/font&gt;&lt;br&gt;a fixed rule over the parser's counts — free, not human&lt;br&gt;rare in real papers: table-heavy 22, scanned 6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="845" width="310" height="125" />
        </mxCell>
        <mxCell id="p1-23" value="parse every page&lt;br&gt;(PyMuPDF, tables on all pages)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-19" target="p1-20">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p1-24" value="label + split by paper" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-20" target="p1-21">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p1-25" value="&lt;b&gt;🧠 GPU box (disposable)&lt;/b&gt;&lt;br&gt;g4dn.xlarge · NVIDIA T4 16 GB · 4 vCPU&lt;br&gt;Deep Learning AMI, Ubuntu 24.04&lt;br&gt;fp16 on T4 · bf16 on A10G/L4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="795" y="160" width="310" height="125" />
        </mxCell>
        <mxCell id="p1-26" value="&lt;b&gt;Training sample (v2)&lt;/b&gt;&lt;br&gt;2,654 rows · natural mix, &lt;b&gt;text capped at 50%&lt;/b&gt;&lt;br&gt;rare labels kept whole" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="795" y="300" width="310" height="95" />
        </mxCell>
        <mxCell id="p1-27" value="&lt;b&gt;QLoRA&lt;/b&gt; on &lt;b&gt;Qwen2.5-1.5B-Instruct&lt;/b&gt;&lt;br&gt;base frozen in 4-bit (nf4)&lt;br&gt;LoRA r=16 on q/k/v/o · &lt;b&gt;4.36 M&lt;/b&gt; trainable of 893 M&lt;br&gt;lr 2e-4 · grad clip 1.0 · 1,000 steps · 15 min" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="795" y="410" width="310" height="140" />
        </mxCell>
        <mxCell id="p1-28" value="&lt;b&gt;Checkpoint selection&lt;/b&gt;&lt;br&gt;every 200 steps, score a 200-page &lt;b&gt;val&lt;/b&gt; slice&lt;br&gt;keep the best → step 400" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="795" y="565" width="310" height="110" />
        </mxCell>
        <mxCell id="p1-29" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;base vs tuned on 600 val + 600 &lt;b&gt;test&lt;/b&gt; pages&lt;br&gt;per-label accuracy · p50 latency&lt;br&gt;test touched &lt;b&gt;once&lt;/b&gt;, at the end" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="795" y="690" width="310" height="140" />
        </mxCell>
        <mxCell id="p1-30" value="&lt;b&gt;Result (champion v2)&lt;/b&gt;&lt;br&gt;test &lt;b&gt;0.978&lt;/b&gt; vs 0.787 always-'text'&lt;br&gt;base model 0.032 · 152 ms/page on the T4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="795" y="845" width="310" height="125" />
        </mxCell>
        <mxCell id="p1-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-26" target="p1-27">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p1-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-27" target="p1-28">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p1-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-28" target="p1-29">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p1-34" value="&lt;b&gt;📒 Tracking&lt;/b&gt; — SQLite &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;mlflow.db&lt;/font&gt;&lt;br&gt;lives in &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;ml/mlflow/mlflow.db&lt;/font&gt;&lt;br&gt;pulled at session start, pushed at the end&lt;br&gt;params · metrics · loss curve · val-selection curve" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1165" y="160" width="310" height="150" />
        </mxCell>
        <mxCell id="p1-35" value="&lt;b&gt;📦 Artifacts&lt;/b&gt; → &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;ml/mlflow/artifacts/&lt;/font&gt;&lt;br&gt;adapter_model.safetensors (17 MB)&lt;br&gt;pyfunc wrapper + code · MLmodel&lt;br&gt;card · dataset manifest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1165" y="325" width="310" height="150" />
        </mxCell>
        <mxCell id="p1-36" value="&lt;b&gt;Registered model&lt;/b&gt; &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;layout-classifier&lt;/font&gt;&lt;br&gt;each version tagged with dataset_version + test_accuracy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1165" y="490" width="310" height="120" />
        </mxCell>
        <mxCell id="p1-37" value="&lt;b&gt;v1&lt;/b&gt;&lt;br&gt;test 0.662&lt;br&gt;&lt;i&gt;rejected&lt;/i&gt;&lt;br&gt;below baseline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1165" y="625" width="145" height="120" />
        </mxCell>
        <mxCell id="p1-38" value="&lt;b&gt;v2&lt;/b&gt;&lt;br&gt;test 0.978&lt;br&gt;@candidate&lt;br&gt;&lt;b&gt;@champion&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1330" y="625" width="145" height="120" />
        </mxCell>
        <mxCell id="p1-39" value="&lt;b&gt;👤 Promotion = human gate&lt;/b&gt;&lt;br&gt;new versions get &lt;b&gt;@candidate&lt;/b&gt; automatically;&lt;br&gt;&lt;b&gt;@champion&lt;/b&gt; is set by a person after reading the card" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1165" y="760" width="310" height="125" />
        </mxCell>
        <mxCell id="p1-40" value="backup before every manual change:&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;ml/mlflow/backups/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1165" y="900" width="310" height="90" />
        </mxCell>
        <mxCell id="p1-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-36" target="p1-37">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p1-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1-36" target="p1-38">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p1-43" value="&lt;b&gt;Load the champion&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;mlflow.pyfunc.load_model(&lt;br&gt;&amp;nbsp;&quot;models:/layout-classifier@champion&quot;)&lt;/font&gt;&lt;br&gt;= base model (Hugging Face) + adapter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1535" y="160" width="310" height="140" />
        </mxCell>
        <mxCell id="p1-44" value="&lt;b&gt;Where it would plug in&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;ingestion/layout_router.py&lt;/font&gt;, tier &lt;b&gt;slm&lt;/b&gt;&lt;br&gt;today that tier calls Ollama qwen2.5:1.5b through &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;llm_gateway&lt;/font&gt; — &lt;b&gt;not this adapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1535" y="315" width="310" height="150" />
        </mxCell>
        <mxCell id="p1-45" value="&lt;b&gt;Serving options&lt;/b&gt;&lt;br&gt;a) pyfunc inside the batch ingest job (CPU, slow)&lt;br&gt;b) merge adapter → GGUF → Ollama (CPU/T4)&lt;br&gt;c) vLLM with the LoRA on a T4/L4 (fast, always-on cost)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1535" y="480" width="310" height="175" />
        </mxCell>
        <mxCell id="p1-46" value="&lt;b&gt;Gate before serving&lt;/b&gt; (ADR-0012)&lt;br&gt;swap in only at &lt;b&gt;≥95% agreement with the frontier model&lt;/b&gt; on held-out pages&lt;br&gt;v2 is measured against the &lt;b&gt;rule&lt;/b&gt;, not the frontier — that eval is still to do" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1535" y="670" width="310" height="170" />
        </mxCell>
        <mxCell id="p1-47" value="&lt;b&gt;Why it is not served yet&lt;/b&gt;&lt;br&gt;the rule is 100% on its own labels, in microseconds, at $0 — a model earns its place only with frontier-made labels" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1535" y="855" width="310" height="135" />
        </mxCell>
        <mxCell id="p1-48" value="launch · ssh · terminate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;exitX=1;exitY=0.35;entryX=0;entryY=0.3;" edge="1" parent="1" source="p1-13" target="p1-25">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="380" y="222" />
              <mxPoint x="380" y="104" />
              <mxPoint x="760" y="104" />
              <mxPoint x="760" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-49" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1-21" target="p1-26">
