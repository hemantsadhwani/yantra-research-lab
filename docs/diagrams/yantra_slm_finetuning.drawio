          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p4-25" value="&lt;b style='font-size:14px'&gt;Next session&lt;/b&gt;&lt;hr&gt;starts again at step 1 on a fresh box — nothing is lost" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="470" width="400" height="150" />
        </mxCell>
        <mxCell id="p4-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p4-16" target="p4-25">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p4-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontFamily=Helvetica;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="p4-25" target="p4-8">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p4-28" value="&lt;b&gt;Survives the terminate&lt;/b&gt;&lt;br&gt;• GitHub: code, tests, runbook, the committed card&lt;br&gt;• S3 bronze: raw PDFs (ingest job)&lt;br&gt;• S3 ml/: page-feature cache, datasets, mlflow.db, adapters&lt;br&gt;&lt;br&gt;&lt;b&gt;Thrown away&lt;/b&gt;&lt;br&gt;• the box and its 100 GB disk: packages, Hugging Face model cache, logs&lt;br&gt;&lt;br&gt;&lt;b&gt;Cost&lt;/b&gt; one session on a T4 ≈ $0.30–0.70 · idle cost between sessions ≈ $0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="690" width="820" height="300" />
        </mxCell>
        <mxCell id="p4-29" value="&lt;b&gt;Safety rails&lt;/b&gt;&lt;br&gt;• nothing bills until &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;launch --yes&lt;/font&gt;; anything over $1 needs the owner's yes&lt;br&gt;• idle alarm stops a forgotten box after 60 min below 2% CPU&lt;br&gt;• &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;layout_session.sh&lt;/font&gt; pushes mlflow.db even when a step fails&lt;br&gt;• a 20-step smoke run before every long run (two bugs caught that way on 1 Oct)&lt;br&gt;• the box role cannot delete anything in S3; promotion to @champion is a human step&lt;br&gt;• terminate only on the owner's words" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="690" width="900" height="300" />
        </mxCell>
      </root>
    </mxGraphModel>
