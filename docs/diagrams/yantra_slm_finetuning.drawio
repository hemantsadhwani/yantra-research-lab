  <diagram name="2 v1 vs v2 champion" id="2_v1_vs_v2_champion">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-1" value="v1 vs v2 (champion) — same data, same model, three changes" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="14" width="1200" height="40" />
        </mxCell>
        <mxCell id="p2-2" value="Both runs: dataset 87060948b499 · Qwen2.5-1.5B-Instruct · QLoRA 4-bit, LoRA r=16 · 1,000 steps · batch 8 · NVIDIA T4. Only the training recipe changed." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="54" width="1300" height="40" />
        </mxCell>
        <mxCell id="p2-3" value="Built and measured ✓" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p2-4" value="Data in S3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p2-5" value="Champion / human gate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p2-6" value="Rejected" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1550" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p2-7" value="Designed, not built" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p2-8" value="&lt;b style='font-size:16px'&gt;v1 — rejected&lt;/b&gt;&lt;hr&gt;&lt;b&gt;learning rate&lt;/b&gt; 1e-3 (fine for the 135M CPU kata, too high for 1.5B)&lt;br&gt;&lt;br&gt;&lt;b&gt;batches&lt;/b&gt; class-balanced: round-robin over the 5 labels, so every batch is ~equal parts text / mixed / figure / table / scanned (6 scanned pages repeated over and over)&lt;br&gt;&lt;br&gt;&lt;b&gt;gradient clipping&lt;/b&gt; none&lt;br&gt;&lt;br&gt;&lt;b&gt;checkpoint&lt;/b&gt; the final weights, step 1000&lt;br&gt;&lt;br&gt;&lt;b&gt;what happened&lt;/b&gt; loss fell to 0.09 by step 700, &lt;b&gt;spiked to 2.07 at step 900&lt;/b&gt;; the saved model came from just after the spike. Trained on a balanced world, it over-guessed rare labels on real pages, where 79% are text." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="120" width="560" height="460" />
        </mxCell>
        <mxCell id="p2-9" value="&lt;b style='font-size:16px'&gt;v2 — champion&lt;/b&gt;&lt;hr&gt;&lt;b&gt;learning rate&lt;/b&gt; 2e-4&lt;br&gt;&lt;br&gt;&lt;b&gt;batches&lt;/b&gt; shuffled over a &lt;b&gt;natural mix with text capped at 50%&lt;/b&gt; (1,500 text · 891 mixed · 241 figure · 16 table · 6 scanned): rare labels kept whole, the model still learns that most pages are text&lt;br&gt;&lt;br&gt;&lt;b&gt;gradient clipping&lt;/b&gt; norm 1.0&lt;br&gt;&lt;br&gt;&lt;b&gt;checkpoint&lt;/b&gt; scored a 200-page val slice every 200 steps, kept the best: &lt;b&gt;step 400&lt;/b&gt; (val slice 0.97 → 1.00 → 1.00 → 1.00 → 1.00)&lt;br&gt;&lt;br&gt;&lt;b&gt;what happened&lt;/b&gt; stable all the way, no spike. Test set used once, at the end." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="120" width="560" height="460" />
        </mxCell>
        <mxCell id="p2-10" value="&lt;b&gt;Test accuracy (600 pages, 41 unseen papers)&lt;/b&gt;" style="text;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="110" width="600" height="30" />
        </mxCell>
        <mxCell id="p2-11" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1300" y="528" width="70" height="12" />
        </mxCell>
        <mxCell id="p2-12" value="&lt;b&gt;0.032&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1285" y="506" width="100" height="22" />
        </mxCell>
        <mxCell id="p2-13" value="base" style="text;html=1;align=center;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1285" y="544" width="100" height="22" />
        </mxCell>
        <mxCell id="p2-14" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="288" width="70" height="252" />
        </mxCell>
        <mxCell id="p2-15" value="&lt;b&gt;0.662&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1435" y="266" width="100" height="22" />
        </mxCell>
        <mxCell id="p2-16" value="v1" style="text;html=1;align=center;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1435" y="544" width="100" height="22" />
        </mxCell>
        <mxCell id="p2-17" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1600" y="168" width="70" height="372" />
        </mxCell>
        <mxCell id="p2-18" value="&lt;b&gt;0.978&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1585" y="146" width="100" height="22" />
        </mxCell>
        <mxCell id="p2-19" value="v2" style="text;html=1;align=center;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1585" y="544" width="100" height="22" />
        </mxCell>
        <mxCell id="p2-20" value="" style="rounded=0;html=1;fillColor=#333333;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="241" width="470" height="2" />
        </mxCell>
        <mxCell id="p2-21" value="always answering 'text' = 0.787" style="text;html=1;align=right;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="217" width="470" height="22" />
        </mxCell>
        <mxCell id="p2-22" value="" style="rounded=0;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="540" width="470" height="2" />
        </mxCell>
        <mxCell id="p2-23" value="&lt;table style='border-collapse:collapse;font-size:13px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #bbb;padding:6px;background:#eeeeee;text-align:left'&gt;Test, per label&lt;/th&gt;&lt;th style='border:1px solid #bbb;padding:6px;background:#eeeeee;text-align:left'&gt;pages&lt;/th&gt;&lt;th style='border:1px solid #bbb;padding:6px;background:#eeeeee;text-align:left'&gt;v1 correct&lt;/th&gt;&lt;th style='border:1px solid #bbb;padding:6px;background:#eeeeee;text-align:left'&gt;v2 correct&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;text&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;472&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;375 (79%)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;&lt;b&gt;472 (100%)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;mixed&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;104&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;14 (13%)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;&lt;b&gt;92 (88%)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;figure-heavy&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;19&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;6 (32%)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;&lt;b&gt;18 (95%)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;table-heavy&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;5&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;2 (40%)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;&lt;b&gt;5 (100%)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;scanned&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;0&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;&lt;b&gt;all&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;&lt;b&gt;600&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;&lt;b&gt;397 (0.662)&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px'&gt;&lt;b&gt;587 (0.978)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="610" width="760" height="260" />
        </mxCell>
        <mxCell id="p2-24" value="&lt;b&gt;How to read this honestly&lt;/b&gt;&lt;br&gt;• v2 copies the parser's rule at 97.8% on papers it never saw. It does &lt;b&gt;not&lt;/b&gt; beat the rule: the rule is 100% on its own labels, in microseconds.&lt;br&gt;• &lt;b&gt;table-heavy&lt;/b&gt; was tested on only 5 pages and &lt;b&gt;scanned&lt;/b&gt; on 0 — no claim either way.&lt;br&gt;• &lt;b&gt;mixed&lt;/b&gt; (88%) is the weak spot: it needs both a table and a figure signal.&lt;br&gt;• Quote 0.978 with its baseline (0.787) and the command that reproduces it: &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;bash deploy/ec2/layout_session.sh&lt;/font&gt; on dataset 87060948b499." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="610" width="1000" height="260" />
        </mxCell>
        <mxCell id="p2-25" value="&lt;b&gt;Where each version lives&lt;/b&gt;&lt;br&gt;&lt;b&gt;v1&lt;/b&gt; — MLflow run 83b7eeba… · artifacts &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;ml/mlflow/artifacts/models/m-5feda329…/&lt;/font&gt; · tag status = rejected (below baseline)&lt;br&gt;&lt;b&gt;v2&lt;/b&gt; — MLflow run 7e312cdc… · artifacts &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;ml/mlflow/artifacts/models/m-ae63ce79…/&lt;/font&gt; · aliases &lt;b&gt;@candidate @champion&lt;/b&gt; (promoted by hand, 1 Oct)&lt;br&gt;both read the same dataset &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;ml/datasets/layout/87060948b499/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="900" width="1800" height="160" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 S3 bucket layout" id="3_S3_bucket_layout">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-1" value="S3 — what lives where, who writes it" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="14" width="1200" height="40" />
        </mxCell>
        <mxCell id="p3-2" value="Bucket &lt;b&gt;yantra-research-lab-data&lt;/b&gt; · ap-south-1 (Mumbai) · encrypted (AES256) · the only durable store besides GitHub. Sizes from &lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;aws s3 ls&lt;/font&gt;, 1 Oct 2026." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="54" width="1300" height="40" />
        </mxCell>
        <mxCell id="p3-3" value="Built and measured ✓" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p3-4" value="Data in S3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p3-5" value="Champion / human gate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p3-6" value="Rejected" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1550" y="20" width="160" height="26" />
        </mxCell>
        <mxCell id="p3-7" value="Designed, not built" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1">
