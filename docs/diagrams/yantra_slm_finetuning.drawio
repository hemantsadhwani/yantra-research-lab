        <mxCell id="p4-8" value="&lt;b style='font-size:14px'&gt;1 · Launch&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0b5394&quot;&gt;launch.sh launch --yes&lt;/font&gt;&lt;br&gt;g6 → g5 → g4dn, zone 1a/1b&lt;br&gt;~2 min" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
