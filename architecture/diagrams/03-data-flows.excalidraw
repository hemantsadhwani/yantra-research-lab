    {
      "id": "text-c62a7d3f73e30851",
      "type": "text",
      "x": 1018,
      "y": 544.4,
      "width": 350,
      "height": 97.2,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
