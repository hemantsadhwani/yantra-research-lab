      "seed": 827375574,
      "version": 1,
      "versionNonce": 1615321365,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751720000000,
      "link": null,
      "locked": false,
      "text": "Re-ingest gotcha: the Dockerfile's build-time\ningest writes a LOCAL index the app never reads.\nAfter any corpus change the cluster must be\nre-indexed over SSH: fly ssh console -a\nyantra-chatbot -C \"sh -c 'cd /app && python\ningest.py'\". A fly deploy alone changes nothing.",
      "originalText": "Re-ingest gotcha: the Dockerfile's build-time ingest writes a LOCAL index the app never reads. After any corpus change the cluster must be re-indexed over SSH: fly ssh console -a yantra-chatbot -C \"sh -c 'cd /app && python ingest.py'\". A fly deploy alone changes nothing.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "center",
      "containerId": "rect-c36086ce0c2c02f9",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 10.0
    },
