    },
    {
      "id": "text-94d9bc21089829f9",
      "type": "text",
      "x": 32,
      "y": 713.7,
      "width": 864,
      "height": 48.6,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1797659199,
      "version": 1,
      "versionNonce": 843939617,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751720000000,
      "link": null,
      "locked": false,
      "text": "Secrets, by NAME ONLY - values live in Fly secrets and GitHub Actions secrets, never in this repo: ANTHROPIC_API_KEY -\nQDRANT_URL - QDRANT_API_KEY - LOGFIRE_TOKEN - LOGFIRE_READ_TOKEN - FRONTEND_ORIGIN. The ingest job additionally reads\nits S3 bucket and AWS credentials from repository secrets.",
      "originalText": "Secrets, by NAME ONLY - values live in Fly secrets and GitHub Actions secrets, never in this repo: ANTHROPIC_API_KEY - QDRANT_URL - QDRANT_API_KEY - LOGFIRE_TOKEN - LOGFIRE_READ_TOKEN - FRONTEND_ORIGIN. The ingest job additionally reads its S3 bucket and AWS credentials from repository secrets.",
